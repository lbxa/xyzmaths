---
import WeeklyProblemPreview from "@/components/WeeklyProblemPreview.astro";
import CollectionLayout from "@/layouts/CollectionLayout.astro";
import { getWeeklyProblems } from "@/lib/weekly-problems";

export const prerender = true;
const problems = await getWeeklyProblems();
const description = "Mathematics and programming problems with solutions and worked editorials.";
---

<CollectionLayout section="pow" title="XYZ PoW" description={description}>
  <header class="mb-phi-4">
    <h1 class="text-title font-bold">XYZ PoW</h1>
    <p class="mt-phi-1 text-lede italic">Problem of the Week</p>
    <p class="mt-phi-2 leading-copy">Try a problem, check your answer against the solution, or read the editorial for the reasoning behind it.</p>
  </header>
  <h2 class="border-b border-ink pb-phi-1 text-heading font-bold">Problem archive</h2>
  <ol class="divide-y divide-rule/50">
    {problems.map(problem => <li class="py-phi-3">
      <WeeklyProblemPreview problem={problem} />
    </li>)}
  </ol>
</CollectionLayout>

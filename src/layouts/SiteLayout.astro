---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "XYZ Mathematics Club",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen bg-frame p-phi-1 text-ink sm:p-phi-2 xl:h-dvh xl:min-h-0 xl:overflow-hidden">
    <div class="mx-auto grid w-full max-w-display grow overflow-hidden rounded-display border border-rule bg-frame shadow-display xl:h-full xl:min-h-0 xl:grid-rows-[minmax(0,1fr)] xl:[grid-template-columns:var(--layout-site-columns)]">
      <aside
        aria-label="Additional information"
        class="order-3 border-t border-rule bg-canvas p-phi-3 xl:sticky xl:top-0 xl:order-1 xl:h-full xl:min-h-0 xl:overflow-y-auto xl:overscroll-contain xl:border-r xl:border-t-0"
      >
        <slot name="left-aside" />
      </aside>

      <main
        id="main-content"
        class="order-1 bg-canvas p-phi-3 sm:p-phi-4 xl:order-2 xl:h-full xl:min-h-0 xl:overflow-y-auto xl:overscroll-contain xl:p-phi-5"
      >
        <slot />
      </main>

      <aside
        aria-label="Site navigation"
        class="order-2 border-t border-rule bg-canvas p-phi-3 xl:sticky xl:top-0 xl:order-3 xl:h-full xl:min-h-0 xl:overflow-y-auto xl:overscroll-contain xl:border-l xl:border-t-0"
      >
        <slot name="right-aside" />
      </aside>
    </div>
  </body>
</html>

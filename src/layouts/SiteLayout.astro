---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import BookSelector from "../components/BookSelector";
import ReadingSettings from "../components/ReadingSettings";
import SeoHead from "../components/SeoHead.astro";
import { TooltipButton, TooltipLink } from "../components/TooltipControls";
import { BookContentsIcon, CloseIcon } from "../components/ui/icons";
import { books } from "../lib/books";
import { readerLinkStyle } from "../lib/reader-links";
import { readingWidthStorageKey } from "../lib/reading-width";
import { preferencePrefix, readerDefaults, readerOptions } from "../lib/reader-preferences";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  currentBook?: string;
  section?: "books" | "pow";
  canonicalPath?: string;
  markdownHref?: string;
  contentsLabel?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  image,
  imageAlt,
  currentBook,
  section,
  canonicalPath,
  markdownHref,
  contentsLabel,
  type,
} = Astro.props;
const bookOptions = books.map(({ slug, title, href }) => ({ slug, title, href }));
const hasContents = Boolean(contentsLabel && Astro.slots.has("left-aside"));
const closeContentsLabel = `Close ${contentsLabel?.toLowerCase() ?? "contents"}`;
const sections = [
  { id: "books", title: "XYZ Books", href: "/books/" },
  { id: "pow", title: "XYZ PoW", href: "/pow/" },
];
const activeSection = sections.find(item => item.id === section);
const siteTitle = activeSection?.title ?? "XYZ Maths";
const isSectionIndex = activeSection?.href === Astro.url.pathname.replace(/\/?$/, "/");
const documentTitle = isSectionIndex || title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script define:vars={{ readingWidthStorageKey, preferencePrefix, readerDefaults, readerOptions }}>
      // Apply saved preferences before the browser paints or React hydrates.
      const root = document.documentElement;
      for (const [key, choices] of Object.entries(readerOptions)) {
        if (root.dataset[key]) continue;
        let value;
        try { value = localStorage.getItem(preferencePrefix + key); } catch {}
        root.dataset[key] = choices.includes(value) ? value : readerDefaults[key];
      }
      if (!document.documentElement.hasAttribute("data-reading-width")) {
        let width = "centred";
        try {
          if (localStorage.getItem(readingWidthStorageKey) === "wide") width = "wide";
        } catch {
          // Use the default measure when the browser blocks storage.
        }
        document.documentElement.dataset.readingWidth = width;
      }
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <SeoHead
      documentTitle={documentTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalPath={canonicalPath}
      type={type}
    />
    <ClientRouter />
  </head>
  <body class="flex h-dvh overflow-hidden bg-frame p-phi-0 text-ink sm:p-phi-2 print:block print:h-auto print:overflow-visible print:bg-canvas print:p-0">
    <div
      data-ascii-intro
      aria-hidden="true"
      hidden
      class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-frame p-phi-3 motion-reduce:hidden"
    >
      <pre
        data-ascii-output
        class="m-0 max-w-full select-none overflow-hidden font-mono text-meta leading-none text-on-frame sm:text-lede md:text-heading"
      ></pre>
    </div>
    <a href="#main-content" class:list={[readerLinkStyle, "sr-only focus:fixed focus:start-phi-2 focus:top-phi-2 focus:z-50 focus:not-sr-only focus:bg-canvas focus:px-phi-tight focus:py-phi-fine"]}>Skip to content</a>
    <div
      data-site-shell
      class="mx-auto flex min-h-0 w-full max-w-display flex-col overflow-hidden rounded-display border border-rule bg-canvas shadow-display print:block print:overflow-visible print:rounded-none print:border-0 print:shadow-none"
    >
      <header data-site-header class="grid shrink-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-x-phi-2 gap-y-phi-1 border-b border-ink px-phi-2 py-phi-0 pointer-coarse:py-phi-1 sm:px-phi-3 md:flex md:min-h-phi-4 print:hidden">
        <TooltipLink client:load tip="Go to the XYZ Maths homepage" href="/" aria-label={activeSection ? `${siteTitle}, XYZ Maths home` : "XYZ Maths home"} className={readerLinkStyle + " inline-flex w-fit items-center gap-phi-1 whitespace-nowrap font-serif text-lede font-bold leading-none tracking-tight sm:text-heading"}>
          <span aria-hidden="true" class="size-phi-3 shrink-0 bg-[url('/favicon.svg')] bg-contain bg-no-repeat max-[24rem]:hidden"></span>
          {siteTitle}
        </TooltipLink>
        {currentBook && <div class="min-w-0 max-w-full justify-self-start">
          <BookSelector client:load books={bookOptions} currentBook={currentBook} />
        </div>}
        <div class:list={[
          "flex min-w-0 flex-wrap items-center gap-x-phi-2 md:ms-auto",
          hasContents ? "col-span-full justify-between border-t border-rule/40 pt-phi-0 md:border-0 md:pt-0" : "justify-end max-[24rem]:contents",
        ]}>
          {hasContents && <div class="md:hidden">
            <TooltipButton client:load tip="Open the book contents" variant="outline"
              type="button" data-drawer-toggle="left" aria-controls="left-aside" aria-expanded="false"
            >
              <BookContentsIcon data-icon="inline-start" />
              {contentsLabel}
            </TooltipButton>
          </div>}
          <nav aria-label="Primary" class:list={[
            "flex flex-wrap items-center justify-end gap-x-phi-1 font-mono text-meta sm:gap-x-phi-2",
            !hasContents && "max-[24rem]:col-span-full max-[24rem]:row-start-2 max-[24rem]:justify-start",
          ]}>
            {sections.map(item => <a
              href={item.href}
              aria-current={activeSection === item ? (isSectionIndex ? "page" : "location") : undefined}
              class:list={[readerLinkStyle, "inline-flex items-center whitespace-nowrap px-phi-tight py-phi-fine pointer-coarse:min-h-touch-target"]}
            >{item.title}</a>)}
          </nav>
          {!currentBook && <div class="justify-self-end max-[24rem]:col-start-2 max-[24rem]:row-start-1 [@media(scripting:none)]:hidden"><ReadingSettings client:load /></div>}
        </div>
      </header>

      <div class:list={[
        "grid min-h-0 flex-1 grid-cols-[minmax(0,1fr)] grid-rows-[minmax(0,1fr)] print:block",
        hasContents && "md:[grid-template-columns:var(--layout-contents)_minmax(0,1fr)]",
      ]}>
        {hasContents && <>
          <button
            type="button"
            data-drawer-backdrop
            data-open="false"
            aria-label="Close side panel"
            tabindex="-1"
            class="invisible fixed inset-0 z-30 bg-frame/70 data-[open=true]:visible print:hidden"
          ></button>

          <aside
            id="left-aside"
            data-drawer="left"
            data-open="false"
            aria-label={contentsLabel}
            tabindex="-1"
            class="invisible fixed inset-y-0 start-0 z-40 w-[min(90vw,var(--spacing-phi-8))] overflow-y-auto overscroll-contain rounded-e-panel border-e border-rule/50 bg-canvas px-phi-2 py-phi-3 data-[open=true]:visible md:visible md:static md:z-auto md:w-auto md:rounded-none xl:px-phi-3 print:hidden"
          >
            <div class="mb-phi-2 flex justify-end md:hidden">
              <TooltipButton client:load tip={closeContentsLabel} variant="outline" size="icon"
                type="button"
                data-drawer-close="left"
                aria-label={closeContentsLabel}
              >
                <CloseIcon />
              </TooltipButton>
            </div>
            <slot name="left-aside" />
          </aside>
        </>}

        <main
          id="main-content"
          tabindex="-1"
          class="relative min-h-0 min-w-0 scroll-pt-phi-2 overflow-y-auto overscroll-contain bg-canvas px-phi-2 py-phi-3 sm:py-phi-4 md:px-phi-3 xl:py-phi-5 print:overflow-visible print:p-0 [&_figure_img]:bg-diagram-paper"
        >
          <slot />
        </main>
      </div>
    </div>

    <script>
      const asciiIntro = document.querySelector<HTMLElement>(
        "[data-ascii-intro]",
      );
      const asciiOutput = asciiIntro?.querySelector<HTMLElement>(
        "[data-ascii-output]",
      );

      if (asciiIntro && asciiOutput) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          asciiIntro.remove();
        } else {
          const asciiFrames = [
            [
              " __  __                ",
              " \\ \\/ /                ",
              "  >  <                 ",
              " /_/\\_\\                ",
            ].join("\n"),
            [
              " __  __ __   __        ",
              " \\ \\/ / \\ \\ / /        ",
              "  >  <   \\ V /         ",
              " /_/\\_\\   |_|          ",
            ].join("\n"),
            [
              " __  __ __   __ ______ ",
              " \\ \\/ / \\ \\ / /|___  / ",
              "  >  <   \\ V /    / /  ",
              " /_/\\_\\   |_|    /____| ",
            ].join("\n"),
          ];
          const asciiStepDuration = 280;
          const asciiHoldDuration = 720;
          let asciiFrameIndex = 0;

          const drawAsciiFrame = () => {
            asciiOutput.textContent = asciiFrames[asciiFrameIndex];
            asciiFrameIndex += 1;

            if (asciiFrameIndex < asciiFrames.length) {
              window.setTimeout(drawAsciiFrame, asciiStepDuration);
              return;
            }

            window.setTimeout(() => asciiIntro.remove(), asciiHoldDuration);
          };

          asciiOutput.textContent = asciiFrames[asciiFrameIndex];
          asciiFrameIndex += 1;
          asciiIntro.hidden = false;
          window.setTimeout(drawAsciiFrame, asciiStepDuration);
        }
      }
    </script>

    <script>
      import { currentFragment } from "../lib/contents-location";
      import { getReadingWidth } from "../lib/reading-width";
      import { getReaderPreferences, preferenceEvent, syncStoredPreference } from "../lib/reader-preferences";

      const tabletQuery = window.matchMedia("(min-width: 48rem)");
      let drawerController: AbortController | undefined;

      const setupContentsDrawer = () => {
        drawerController?.abort();
        drawerController = new AbortController();
        const { signal } = drawerController;
        const shell = document.querySelector<HTMLElement>("[data-site-shell]");
        if (!shell) return;

        const drawer = shell.querySelector<HTMLElement>("#left-aside");
        const trigger = shell.querySelector<HTMLButtonElement>("[data-drawer-toggle]");
        const closeButton = drawer?.querySelector<HTMLButtonElement>("[data-drawer-close]");
        const backdrop = shell.querySelector<HTMLButtonElement>("[data-drawer-backdrop]");
        const header = shell.querySelector<HTMLElement>("[data-site-header]");
        const main = shell.querySelector<HTMLElement>("main");
        if (!drawer || !trigger || !closeButton || !backdrop || !header || !main) return;

        const setOpen = (open: boolean) => {
          const docked = tabletQuery.matches;
          drawer.dataset.open = String(open);
          drawer.inert = !docked && !open;
          drawer.setAttribute("aria-hidden", String(drawer.inert));
          if (docked) {
            drawer.removeAttribute("role");
            drawer.removeAttribute("aria-modal");
          } else {
            drawer.setAttribute("role", "dialog");
            drawer.setAttribute("aria-modal", "true");
          }
          trigger.setAttribute("aria-expanded", String(open));
          backdrop.dataset.open = String(open);
          header.inert = open;
          main.inert = open;
        };
        const dismiss = () => {
          setOpen(false);
          trigger.focus();
        };

        trigger.addEventListener("click", () => {
          if (tabletQuery.matches) return;
          setOpen(true);
          closeButton.focus();
        }, { signal });
        closeButton.addEventListener("click", dismiss, { signal });
        backdrop.addEventListener("click", dismiss, { signal });
        drawer.addEventListener("click", (event) => {
          if (drawer.dataset.open === "true" && event.target instanceof Element && event.target.closest("a[href]")) {
            setOpen(false);
          }
        }, { signal });

        document.addEventListener(
          "keydown",
          (event) => {
            if (drawer.dataset.open !== "true") return;

            if (event.key === "Escape") {
              if (event.defaultPrevented || document.querySelector('[role="tooltip"]:not([data-ending-style])')) return;
              event.preventDefault();
              dismiss();
              return;
            }

            if (event.key !== "Tab") return;
            const focusable = Array.from(
              drawer.querySelectorAll<HTMLElement>(
                'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
              ),
            ).filter((element) => element.getClientRects().length > 0);
            if (focusable.length === 0) {
              event.preventDefault();
              drawer.focus();
              return;
            }

            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          },
          { signal },
        );

        tabletQuery.addEventListener("change", () => setOpen(false), { signal });
        setOpen(false);
      };

      document.addEventListener("astro:page-load", setupContentsDrawer);
      window.addEventListener("storage", syncStoredPreference);
      const syncBrowserChrome = () => {
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        if (meta) meta.content = getComputedStyle(document.body).backgroundColor;
      };
      document.addEventListener("astro:page-load", syncBrowserChrome);
      window.addEventListener(preferenceEvent, syncBrowserChrome);
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncBrowserChrome);
      document.addEventListener("astro:before-swap", (event) => {
        drawerController?.abort();
        Object.assign(event.newDocument.documentElement.dataset, getReaderPreferences());
        event.newDocument.documentElement.dataset.readingWidth = getReadingWidth();
      });

      // The reader scrolls inside main. Save its position alongside Astro's window position.
      const saveReadingPosition = () => {
        const top = document.getElementById("main-content")?.scrollTop;
        if (top !== undefined && history.state && history.state.readingScrollTop !== top) {
          history.replaceState({ ...history.state, readingScrollTop: top }, "");
        }
      };
      document.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a[href]")) saveReadingPosition();
      }, { capture: true });
      window.addEventListener("pagehide", saveReadingPosition);

      const restoreReadingPosition = () => {
        const href = location.href;
        const top = history.state?.readingScrollTop;
        requestAnimationFrame(() => {
          const main = document.getElementById("main-content");
          if (!main || location.href !== href) return;
          if (typeof top === "number") {
            main.scrollTop = top;
          } else if (location.hash) {
            const target = document.getElementById(currentFragment().slice(1));
            if (target && main.contains(target)) target.scrollIntoView({ block: "start", behavior: "instant" });
          }
        });
      };
      let readingPath = location.pathname;
      window.addEventListener("pageshow", restoreReadingPosition);
      window.addEventListener("popstate", () => {
        if (location.pathname === readingPath) restoreReadingPosition();
      });
      document.addEventListener("astro:after-swap", () => {
        readingPath = location.pathname;
        restoreReadingPosition();
      });
    </script>
  </body>
</html>

---
import ProblemNavigation from "@/components/ProblemNavigation.astro";
import { ArrowRightIcon } from "@/components/ui/icons";
import CollectionLayout from "@/layouts/CollectionLayout.astro";
import { books } from "@/lib/books";
import { readerLinkStyle } from "@/lib/reader-links";
import { formatProblemDate, getWeeklyProblems, problemHref } from "@/lib/weekly-problems";

export const prerender = true;
const [latest] = await getWeeklyProblems();
const description = "Mathematics books and weekly problem editorials by Lucas Barbosa.";
const sectionLink = readerLinkStyle + " inline-flex items-center gap-phi-1 [&_svg]:size-phi-2";
---

<CollectionLayout wide title="XYZ Maths" description={description}>
  <header class="mb-phi-4">
    <h1 class="text-title font-bold">XYZ Maths</h1>
    <p class="mt-phi-1 text-lede italic">{description}</p>
  </header>
  <div class="grid items-start gap-phi-4 md:grid-cols-[3fr_2fr] md:gap-phi-5">
    <section aria-labelledby="books" class="min-w-0 border-t border-ink pt-phi-2">
      <h2 id="books" class="text-heading font-bold"><a href="/books/" class={sectionLink}>XYZ Books <ArrowRightIcon /></a></h2>
      {books.map(book => <section class="mt-phi-3">
        <h3 class="text-lede font-bold"><a href={book.href} class={readerLinkStyle}>{book.title}</a></h3>
        <p class="mt-phi-0 leading-copy">{book.description}</p>
        <nav aria-label={book.title + " editions"} class="mt-phi-2 flex flex-wrap gap-x-phi-2 gap-y-phi-1 font-mono text-meta">
          <a href={book.href} class:list={[readerLinkStyle, "inline-flex items-center font-bold pointer-coarse:min-h-touch-target"]}>Read online</a>
          <a href={book.manuscript.href} data-astro-reload class:list={[readerLinkStyle, "inline-flex items-center pointer-coarse:min-h-touch-target"]}>Download manuscript (PDF)</a>
        </nav>
        {book.frontispiece && <figure class="mt-phi-3">
          <a href={book.href + book.frontispiece.destination} class:list={[readerLinkStyle, "inline-block max-w-full"]}>
            <img src={book.href + book.frontispiece.image} alt={book.frontispiece.alt} class="h-auto max-h-phi-7 max-w-full" />
          </a>
          <figcaption class="mt-phi-0 text-sidenote italic">{book.frontispiece.caption}</figcaption>
        </figure>}
      </section>)}
    </section>
    <section aria-labelledby="pow" class="min-w-0 border-t border-ink pt-phi-2">
      <h2 id="pow" class="text-heading font-bold"><a href="/pow/" class={sectionLink}>XYZ PoW <ArrowRightIcon /></a></h2>
      <p class="mt-phi-3 text-lede italic">Problem of the Week</p>
      {latest && <>
        <p class="mt-phi-2 font-mono text-meta">Latest problem · <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatProblemDate(latest.data.date)}</time></p>
        <h3 class="mt-phi-0 text-lede font-bold"><a href={problemHref(latest.id)} class={readerLinkStyle}>{latest.data.title}</a></h3>
        <p class="mt-phi-0 leading-copy">{latest.data.description}</p>
        <ProblemNavigation id={latest.id} title={latest.data.title} />
      </>}
    </section>
  </div>
</CollectionLayout>

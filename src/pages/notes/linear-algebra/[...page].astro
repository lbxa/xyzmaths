---
import { render } from "astro:content";
import BookNotes from "../../../layouts/BookNotes.astro";
import { getBookPages } from "../../../lib/book-contents";
import { linearAlgebra } from "../../../lib/books";
import { manuscriptLinkStyles } from "../../../lib/reader-links";
export const prerender = true;
export async function getStaticPaths() {
  return (await getBookPages(linearAlgebra)).map((entry) => ({
    params: { page: entry.id }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BookNotes book={linearAlgebra} title={entry.data.title}>
  <div class={manuscriptLinkStyles}><Content /></div>
</BookNotes>

---
import { render } from "astro:content";
import BookNotes from "../../../layouts/BookNotes.astro";
import { getBookAssignments } from "../../../lib/book-contents";
import { linearAlgebra } from "../../../lib/books";
import { manuscriptLinkStyles, readerLinkStyle } from "../../../lib/reader-links";
export const prerender = true;
const base = linearAlgebra.href;
const assignments = await getBookAssignments(linearAlgebra);
---
<BookNotes book={linearAlgebra} title="All problems">
  <h1>All problems</h1>
  {assignments.map(({ id, title, problems }) => <section id={id}>
    <h2>{title}</h2>
    {problems.map(async ({ entry, title }) => {
      const { id, data } = entry;
      const { Content } = await render(entry);
      return <section id={id} class="my-phi-3 border-t border-rule">
        <h3>{title}</h3>
        <div class={manuscriptLinkStyles}><Content /></div>
        <p><a href={`${base}${data.statementPage}/#ex:${id}`} class={readerLinkStyle}>Exercise {data.number} in the chapter</a>
          {" · "}<a href={`${base}${data.solutionPage}/#sol:${id}`} class={readerLinkStyle}>Appendix solution</a></p>
      </section>;
    })}
  </section>)}
</BookNotes>
